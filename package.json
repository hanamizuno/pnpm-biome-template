{
  "name": "pnpm-biome-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "bench": "vitest bench",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "release-check": "biome ci . && tsc --noEmit && vitest run",
    "scan:secrets": "pnpm exec secretlint \"**/*\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@secretlint/secretlint-rule-preset-recommend": "^8.5.0",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^3.2.6",
    "secretlint": "^8.5.0",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vitest": "^3.2.6"
  }
}
