{
  "name": "pnpm-biome-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/main.ts",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "bench": "vitest bench",
    "fmt": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "release-check": "biome ci . && tsc --noEmit && vitest run",
    "scan:secrets": "npx secretlint \"**/*\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@secretlint/secretlint-rule-preset-recommend": "^8.0.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.0.0",
    "secretlint": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
