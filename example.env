# pass:// 参照の書き方サンプル — .env にコピーして使う（.env は git-ignore のまま）。
#
# 値はすべて Proton Pass アイテムへの「参照」であり、シークレット本体ではない。
# `pass-cli run --env-file .env -- <cmd>` が実行時に解決し、<cmd> の環境変数にのみ注入する
# （stdout/stderr はマスクされる）。
#
# 参照は ID ベース — pass://SHARE_ID/ITEM_ID/FIELD — であり、URI に vault 名や
# アイテム名を書いても解決されない（pass-cli はそのまま素通しする）。ID は
# `.devcontainer/pass-relogin` の後に以下で調べる:
#   pass-cli item list --vault-name <vault> --output json   # -> share_id, id
# ID は不透明な識別子なので、このサンプルにコミットしても問題ない。実体の .env は
# 「本物のトークンをうっかり書いた」事故への保険として ignore のままにする。
#
# プロジェクト別 vault を使う場合（PAT ファイル ~/.config/proton-pass-agent/<ディレクトリ名>、
# README「タスク用シークレット」参照）は、その vault のアイテム ID から参照を作る。
# アイテム名 `github-fine-grained` は固定の規約 — .devcontainer/pass-relogin が
# PAT から見える vault のこの名前のアイテムから gh 認証を seed する。

# GitHub fine-grained PAT (gh CLI / git push 用)
GITHUB_TOKEN=pass://<SHARE_ID>/<ITEM_ID>/token
GH_TOKEN=pass://<SHARE_ID>/<ITEM_ID>/token

# 汎用 API キーの例
# OPENAI_API_KEY=pass://<SHARE_ID>/<ITEM_ID>/api-key
# CLOUDFLARE_API_TOKEN=pass://<SHARE_ID>/<ITEM_ID>/api-token
